<?xml version="1.0"?>
<scenario>
	<environment>
		<ned latitude="0.0" longitude="0.0" />

		<ocean>
			<water density="1025.0" jerlov="0.2" />
			<waves height="0.0" />
			<current type="uniform">
				<velocity xyz="0.0 0.0 0.0" />
			</current>
		</ocean>

		<atmosphere>
			<sun azimuth="0.0" elevation="60.0" />
		</atmosphere>
	</environment>

	<materials>
		<material name="Fiberglass" density="1800.0" restitution="0.3" />
		<material name="Neutral" density="1000.0" restitution="0.5" />
		<material name="aluminium" density="2700.0" restitution="0.8" />
		<material name="steel" density="7810.0" restitution="0.9" />
		<material name="pvc" density="1500.0" restitution="0.4" />
		<material name="acrylic" density="1200.0" restitution="0.3" />
		<friction_table>
			<friction material1="aluminium" material2="aluminium" static="0.7" dynamic="0.5" />
			<friction material1="steel" material2="steel" static="0.4" dynamic="0.2" />
			<friction material1="aluminium" material2="steel" static="0.6" dynamic="0.4" />
			<friction material1="pvc" material2="pvc" static="0.4" dynamic="0.2" />
			<friction material1="pvc" material2="steel" static="0.5" dynamic="0.3" />
			<friction material1="pvc" material2="aluminium" static="0.5" dynamic="0.3" />
		</friction_table>
	</materials>

	<looks>
		<look name="yellow" rgb="1.0 1.0 0.0" roughness="0.1" metalness="0.0" />
		<look name="gray" rgb="0.5 0.5 0.5" roughness="0.3" metalness="0.0" />
		<look name="white" rgb="0.95 0.95 0.95" roughness="0.3" metalness="0.0" />
		<look name="red" rgb="0.9 0.0 0.0" roughness="0.3" metalness="0.0" />
		<look name="black" rgb="0.0 0.0 0.0" roughness="0.1" metalness="0.0" />
		<look name="green" rgb="0.0 0.2 0.0" roughness="0.1" metalness="0.1" />
		<look name="propeller" gray="1.0" roughness="0.3" />
		<look name="gatetex" gray="1.0" roughness="0.3" texture="textures/gate.png" />
		<look name="bintex" gray="1.0" roughness="0.3" texture="textures/bin.png" />
		<look name="boardtex" gray="1.0" roughness="0.3" texture="textures/board.png" />
	</looks>

	<static name="Ground" type="plane">
		<material name="steel" />
		<look name="gray" />
		<world_transform rpy="0.0 0.0 0.0" xyz="0.0 0.0 2.1" />
	</static>

	<static name="Wall1" type="box">
		<dimensions xyz="50.0 0.2 2.4" />
		<material name="steel" />
		<look name="gray" />
		<world_transform rpy="0.0 0.0 0.0" xyz="25.0 0.0 0.9" />
	</static>

	<static name="Wall2" type="box">
		<dimensions xyz="0.2 22.86 2.4" />
		<material name="steel" />
		<look name="gray" />
		<world_transform rpy="0.0 0.0 0.0" xyz="50.0 11.43 0.9" />
	</static>

	<static name="Wall3" type="box">
		<dimensions xyz="50.0 0.2 2.4" />
		<material name="steel" />
		<look name="gray" />
		<world_transform rpy="0.0 0.0 0.0" xyz="25.0 22.86 0.9" />
	</static>

	<static name="Wall4" type="box">
		<dimensions xyz="0.2 22.86 2.4" />
		<material name="steel" />
		<look name="gray" />
		<world_transform rpy="0.0 0.0 0.0" xyz="0.0 11.43 0.9" />
	</static>

	<static name="Gate" type="model">
		<physical>
			<mesh filename="models/gate.obj" scale="1.0" convex="false" />
			<origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0" />
		</physical>
		<visual>
			<mesh filename="models/gate.obj" scale="1.0" />
			<origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0" />
		</visual>
		<material name="steel" />
		<look name="gatetex" />
		<world_transform rpy="0.0 0.0 0.0" xyz="3.0 3.0 2.1" />
	</static>

	<static name="Marker" type="model">
		<physical>
			<mesh filename="models/marker.obj" scale="1.0" convex="false" />
			<origin xyz="0.0 0.0 -1.0" rpy="0.0 3.1415 0.0" />
		</physical>
		<material name="steel" />
		<look name="yellow" />
		<world_transform rpy="0.0 0.0 1.571" xyz="3.0 3.0 2.75" />
	</static>

	<static name="Pole1" type="cylinder">
		<dimensions radius="0.0254" height="0.9" />
		<material name="acrylic" />
		<look name="white" />
		<world_transform rpy="0.0 0.0 0.0" xyz="1.5 5.0 0.45" />
	</static>

	<static name="Pole2" type="cylinder">
		<dimensions radius="0.0254" height="0.9" />
		<material name="acrylic" />
		<look name="white" />
		<world_transform rpy="0.0 0.0 0.0" xyz="3.0 5.0 0.45" />
	</static>

	<static name="Pole3" type="cylinder">
		<dimensions radius="0.0254" height="0.9" />
		<material name="acrylic" />
		<look name="white" />
		<world_transform rpy="0.0 0.0 0.0" xyz="4.5 5.0 0.45" />
	</static>

	<static name="Pole4" type="cylinder">
		<dimensions radius="0.0254" height="0.9" />
		<material name="acrylic" />
		<look name="red" />
		<world_transform rpy="0.0 0.0 0.0" xyz="2.0 6.5 0.45" />
	</static>

	<static name="Pole5" type="cylinder">
		<dimensions radius="0.0254" height="0.9" />
		<material name="acrylic" />
		<look name="red" />
		<world_transform rpy="0.0 0.0 0.0" xyz="3.5 6.5 0.45" />
	</static>

	<static name="Pole6" type="cylinder">
		<dimensions radius="0.0254" height="0.9" />
		<material name="acrylic" />
		<look name="red" />
		<world_transform rpy="0.0 0.0 0.0" xyz="5.0 6.5 0.45" />
	</static>

	<static name="Pole7" type="cylinder">
		<dimensions radius="0.0254" height="0.9" />
		<material name="acrylic" />
		<look name="white" />
		<world_transform rpy="0.0 0.0 0.0" xyz="1.5 8.0 0.45" />
	</static>

	<static name="Pole8" type="cylinder">
		<dimensions radius="0.0254" height="0.9" />
		<material name="acrylic" />
		<look name="white" />
		<world_transform rpy="0.0 0.0 0.0" xyz="3.0 8.0 0.45" />
	</static>

	<static name="Pole9" type="cylinder">
		<dimensions radius="0.0254" height="0.9" />
		<material name="acrylic" />
		<look name="white" />
		<world_transform rpy="0.0 0.0 0.0" xyz="4.5 8.0 0.45" />
	</static>

	<static name="Bin" type="model">
		<physical>
			<mesh filename="models/bin.obj" scale="1.0" convex="false" />
			<origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0" />
		</physical>
		<visual>
			<mesh filename="models/bin.obj" scale="1.0" />
			<origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0" />
		</visual>
		<material name="steel" />
		<look name="bintex" />
		<world_transform rpy="3.14159 0.0 0.0" xyz="3.0 10.0 2.09" />
	</static>

	<static name="Board" type="model">
		<physical>
			<mesh filename="models/board.obj" scale="1.0" convex="false" />
			<origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0" />
		</physical>
		<visual>
			<mesh filename="models/board.obj" scale="1.0" />
			<origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0" />
		</visual>
		<material name="steel" />
		<look name="boardtex" />
		<world_transform rpy="0.0 0.0 0.0" xyz="1.5 12.0 1.0" />
	</static>

	<!-- Girona500 AUV instance -->
	<include file="scenarios/girona500_auv.scn">
		<arg name="robot_name" value="Girona500AUV" />
		<arg name="robot_rpy" value="0.0 0.0 0.0" />
		<arg name="robot_position" value="1.0 1.0 1.0" />
	</include>
</scenario>
